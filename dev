#!/usr/bin/env bash
# Start the API and Expo against hosted Supabase.
set -euo pipefail
cd "$(dirname "$0")"

case "${1:-}" in
  up)
    if [[ "${2:-}" != "" ]]; then
      echo "Usage: ./dev up | ./dev down" >&2
      exit 1
    fi
    command -v docker >/dev/null || { echo "Docker is required." >&2; exit 1; }
    command -v node >/dev/null || { echo "Node.js is required." >&2; exit 1; }
    command -v npm >/dev/null || { echo "npm is required." >&2; exit 1; }
    node -e 'const [major, minor] = process.versions.node.split(".").map(Number); if (!((major === 22 && minor >= 13) || (major >= 24 && major % 2 === 0 && (major > 24 || minor >= 3)))) { console.error("Expo SDK 57 needs Node.js 22.13+ or 24.3+ (LTS). Current: " + process.version); process.exit(1); }'
    docker info >/dev/null 2>&1 || { echo "Start Docker Desktop, then retry ./dev up." >&2; exit 1; }
    mkdir -p .dev
    if [[ ! -f apps/mobile/.env.cloud || ! -f apps/api/.env.cloud ]]; then
      echo "Cloud env files are missing. See SETUP.md." >&2
      exit 1
    fi
    if ! grep -Eq '^SUPABASE_SERVICE_ROLE_KEY=.+$' apps/api/.env.cloud; then
      echo "Add the hosted legacy service_role key to apps/api/.env.cloud before starting." >&2
      exit 1
    fi
    API_ENV_FILE=./apps/api/.env.cloud docker compose up --build -d
    export EXPO_NO_DOTENV=1
    expo_node=(node --env-file=apps/mobile/.env.cloud)
    "${expo_node[@]}" -e 'console.log("Using hosted Supabase: " + process.env.EXPO_PUBLIC_SUPABASE_URL)'

    if [ ! -f apps/mobile/node_modules/.package-lock.json ] || ! node -e 'require.resolve("qrcode-terminal", { paths: ["./apps/mobile"] })' >/dev/null 2>&1; then
      npm ci --prefix apps/mobile
    fi
    node scripts/expo-process.mjs stop
    "${expo_node[@]}" scripts/expo-process.mjs start
    "${expo_node[@]}" scripts/expo-qr.mjs
    echo "API: http://localhost:8000/docs"
    echo "Expo: http://localhost:8081 (logs: .dev/expo.log)"
    echo "Use ./dev down to stop this stack."
    ;;
  down)
    if [[ "${2:-}" != "" ]]; then
      echo "Usage: ./dev up | ./dev down" >&2
      exit 1
    fi
    node scripts/expo-process.mjs stop
    docker compose down
    ;;
  *)
    echo "Usage: ./dev up | ./dev down" >&2
    exit 1
    ;;
esac
