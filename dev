#!/usr/bin/env bash
# Local dev helper: ./dev up | ./dev down
set -euo pipefail
cd "$(dirname "$0")"

if command -v supabase >/dev/null 2>&1; then
  SUPABASE=(supabase)
else
  SUPABASE=(npx --yes supabase)
fi

case "${1:-}" in
  up)
    if [ ! -f apps/api/.env ]; then
      cp apps/api/.env.example apps/api/.env
      echo "Created apps/api/.env — add SUPABASE_SERVICE_ROLE_KEY and GEMINI_API_KEY, then re-run './dev up'."
      echo "(Keys: run '${SUPABASE[*]} start' once, then '${SUPABASE[*]} status'.)"
    fi
    "${SUPABASE[@]}" start
    docker compose up --build -d
    echo
    echo "API:      http://localhost:8000  (docs: http://localhost:8000/docs)"
    echo "Supabase: run '${SUPABASE[*]} status' for URLs and keys"
    echo "Mobile:   cd apps/mobile && npx expo start"
    ;;
  down)
    docker compose down
    "${SUPABASE[@]}" stop
    ;;
  *)
    echo "Usage: ./dev up | ./dev down" >&2
    exit 1
    ;;
esac
