# Copy to .env.cloud and fill in. Never commit the real file.
ENVIRONMENT=development

# Hosted Supabase project URL and legacy service_role key from its dashboard.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET_RECEIPTS=receipts
SUPABASE_STORAGE_BUCKET_MEMORIES=memories

# Gemini vision for receipt parsing
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Comma-separated list of allowed origins (Expo web / dev tools)
CORS_ORIGINS=http://localhost:8081
