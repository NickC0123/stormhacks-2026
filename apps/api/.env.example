# Copy to .env and fill in. Never commit the real file.
ENVIRONMENT=development

# Supabase (from `supabase status` locally, or the project dashboard).
# From inside Docker, reach a local Supabase stack via host.docker.internal.
SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET_RECEIPTS=receipts
SUPABASE_STORAGE_BUCKET_MEMORIES=memories

# Gemini vision for receipt parsing
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Comma-separated list of allowed origins (Expo web / dev tools)
CORS_ORIGINS=http://localhost:8081
